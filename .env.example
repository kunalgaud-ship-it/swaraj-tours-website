# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps API key for Maps, Places Autocomplete & Routes
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Supabase: public values used by the admin sign-in page
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase: server-only values. Never add VITE_ to the secret key.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Set to the final public domain before production builds to generate canonical URLs and sitemap.xml.
SITE_URL="https://your-domain.com"

# Transactional booking emails (server-side only; never use the VITE_ prefix)
RESEND_API_KEY="MY_RESEND_API_KEY"
BOOKING_FROM_EMAIL="Swaraj Tours <bookings@your-verified-domain.com>"
BOOKING_NOTIFICATION_EMAIL="shivrajtravels1@gmail.com"
